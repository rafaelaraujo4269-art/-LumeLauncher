#!/usr/bin/env sh
# Lightweight bootstrapper for the official Gradle distribution.
# The Gradle binary is downloaded once into GRADLE_USER_HOME.
set -eu

APP_HOME="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
GRADLE_VERSION="8.13"
USER_GRADLE_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}"
CACHE_DIR="$USER_GRADLE_HOME/lume-bootstrap/gradle-$GRADLE_VERSION"
GRADLE_HOME="$CACHE_DIR/gradle-$GRADLE_VERSION"
GRADLE_BIN="$GRADLE_HOME/bin/gradle"
ARCHIVE="$CACHE_DIR/gradle-$GRADLE_VERSION-bin.zip"

if [ ! -x "$GRADLE_BIN" ]; then
    mkdir -p "$CACHE_DIR"
    if [ ! -f "$ARCHIVE" ]; then
        URL="https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip"
        if command -v curl >/dev/null 2>&1; then
            curl --fail --location --retry 3 "$URL" --output "$ARCHIVE"
        elif command -v wget >/dev/null 2>&1; then
            wget -O "$ARCHIVE" "$URL"
        else
            echo "Erro: instale curl ou wget para baixar o Gradle." >&2
            exit 1
        fi
    fi
    if ! command -v unzip >/dev/null 2>&1; then
        echo "Erro: o comando unzip é necessário para preparar o Gradle." >&2
        exit 1
    fi
    unzip -q -o "$ARCHIVE" -d "$CACHE_DIR"
    rm -f "$ARCHIVE"
fi

exec "$GRADLE_BIN" -p "$APP_HOME" "$@"
